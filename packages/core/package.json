{
  "name": "@shaohui_jin/git-insight-core",
  "version": "0.1.0",
  "description": "Git branch graph, merge conflict preview, and conflict provenance engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "git-insight": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui/server": {
      "types": "./dist/ui/uiServer.d.ts",
      "import": "./dist/ui/uiServer.js"
    },
    "./merge/branchName": {
      "types": "./dist/merge/branchName.d.ts",
      "import": "./dist/merge/branchName.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/**/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "git",
    "merge-tree",
    "conflict",
    "branch-graph"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
