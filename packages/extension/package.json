{
  "name": "git-insight",
  "displayName": "Git Insight",
  "description": "Branch graph, merge conflict preview, merge matrix, one-click resolve & push, and create MR/PR. See docs/features.md for capability matrix.",
  "version": "0.3.2",
  "publisher": "jinshaohui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shaohui-jin/git-skills.git"
  },
  "bugs": {
    "url": "https://github.com/shaohui-jin/git-skills/issues"
  },
  "homepage": "https://github.com/shaohui-jin/git-skills#readme",
  "keywords": [
    "git",
    "merge",
    "conflict",
    "branch",
    "github",
    "gitlab",
    "mr",
    "pr",
    "cursor"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["SCM Providers", "Other"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gitInsight.openWeb",
    "onCommand:gitInsight.previewMerge",
    "onCommand:gitInsight.openPreview",
    "onCommand:gitInsight.syncSkill",
    "onCommand:gitInsight.checkConflicts",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitInsight.openWeb",
        "title": "Git Insight: Open Web",
        "category": "Git Insight"
      },
      {
        "command": "gitInsight.previewMerge",
        "title": "Git Insight: 合并预演",
        "category": "Git Insight"
      },
      {
        "command": "gitInsight.openPreview",
        "title": "Git Insight: 打开预演（可带 into/from）",
        "category": "Git Insight"
      },
      {
        "command": "gitInsight.syncSkill",
        "title": "Git Insight: 同步 Agent Skill 到全局",
        "category": "Git Insight"
      },
      {
        "command": "gitInsight.checkConflicts",
        "title": "Git Insight: 立即检查合并冲突",
        "category": "Git Insight"
      }
    ],
    "configuration": {
      "title": "Git Insight",
      "properties": {
        "gitInsight.conflictWatcher.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "后台定期检查你的分支还能不能干净合进目标分支，**变糟时**才提醒。默认关闭。\n\n检查全程用 `git merge-tree`，不改工作区、不建分支、不产生提交。"
        },
        "gitInsight.conflictWatcher.intervalMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "description": "检查间隔（分钟）。窗口重新获得焦点时也会顺带检查一次。"
        },
        "gitInsight.conflictWatcher.into": {
          "type": "string",
          "default": "",
          "description": "线上目标分支，如 origin/master。留空则自动取远程 HEAD，再依次回退 main / master / develop。"
        },
        "gitInsight.conflictWatcher.branches": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "要盯着的分支。留空则只看当前所在分支。"
        },
        "gitInsight.conflictWatcher.notify": {
          "type": "string",
          "enum": ["worse", "always", "never"],
          "default": "worse",
          "enumDescriptions": [
            "只在变糟时弹通知：新出现冲突，或冲突文件变多",
            "只要有冲突每轮都弹",
            "从不弹通知，只更新状态栏"
          ],
          "description": "什么时候弹通知。状态栏无论如何都会更新。"
        }
      }
    },
    "chatSkills": [
      {
        "path": "./skills/git-branch-insight/SKILL.md"
      }
    ]
  },
  "scripts": {
    "build:webview": "pnpm --filter @git-insight/webview run build",
    "build:ext": "node scripts/bundle.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run build:webview && pnpm run build:ext",
    "preview": "tsx scripts/preview.ts",
    "package:vsix": "pnpm run build && vsce package --no-dependencies --out ../../git-insight.vsix",
    "publish:ovsx": "pnpm run package:vsix && ovsx publish ../../git-insight.vsix"
  },
  "devDependencies": {
    "@shaohui_jin/git-insight-core": "workspace:*",
    "@types/node": "^22.15.21",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.5",
    "ovsx": "^0.10.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "ws": "^8.18.2"
  }
}
