{
  "name": "@shaohui_jin/git-insight-mcp-server",
  "version": "0.2.2",
  "description": "MCP server exposing git-insight branch graph, merge preview, batch survey, merge-order planning and MR creation",
  "type": "module",
  "bin": {
    "git-insight-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "git",
    "merge-tree",
    "conflict"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@shaohui_jin/git-insight-core": "workspace:*",
    "@types/node": "^22.15.21",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  }
}
