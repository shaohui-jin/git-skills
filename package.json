{
  "name": "git-skill",
  "private": true,
  "version": "0.1.0",
  "description": "Git branch insight monorepo: core engine + Cursor skill + extension shell",
  "scripts": {
    "build": "pnpm --filter @git-insight/core build && pnpm --filter git-insight build",
    "build:all": "pnpm -r run build",
    "dev": "pnpm --filter @git-insight/core run build --watch",
    "preview": "pnpm --filter @git-insight/core build && pnpm --filter git-insight preview",
    "preview:repo": "pnpm --filter @git-insight/core build && pnpm --filter git-insight preview --",
    "package:vsix": "pnpm --filter @git-insight/core build && pnpm --filter git-insight package:vsix",
    "publish:ovsx": "pnpm --filter @git-insight/core build && pnpm --filter git-insight publish:ovsx",
    "git-insight": "pnpm --filter @git-insight/core exec node dist/cli.js",
    "test": "pnpm --filter @git-insight/core run test"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1"
}
